from microbit import *
import sensoren
import motoren

zoek_einde = False
uitvoeren = False
draaien_rechts = False
draaien_links = False
display.off()


motoren.stoppen()

print('configured for flight')
while True:
    if button_a.was_pressed() and not uitvoeren:
        uitvoeren = True
        print('start')

    if button_b.was_pressed() and uitvoeren:
        uitvoeren = False
        motoren.stoppen()

    if uitvoeren:
        links, rechts = sensoren.meet_lijnsensoren()
        AV = sensoren.afstand_vooruit()

        if draaien_rechts:
            if links == 1 and AV >= 15:
                motoren.stoppen()
                zoek_einde = False
                draaien_rechts = False
            else:
                motoren.rechts_draaien()

        elif draaien_links:
            if rechts == 1 and AV >= 15:
                motoren.stoppen()
                zoek_einde = False
                draaien_links = False
            else:
                motoren.links_draaien()

        elif AV <= 4:
            motoren.stoppen()

               

        elif links == 0 and rechts == 0:
            motoren.vooruit()

        elif links == 1 and rechts == 0:
            motoren.links_bijsturen()

        elif links == 0 and rechts == 1:
            motoren.rechts_bijsturen()

        elif links == 1 and rechts == 1:
            AR = sensoren.afstand_rechts()
            AL = sensoren.afstand_links()
            if AR >= 10:
                motoren.stoppen()
                draaien_rechts = True
                motoren.rechts_draaien()
            elif AL>=10:
                motoren.stoppen()
                draaien_links = True
                motoren.links_draaien()
            else:
                motoren.vooruit()
         
